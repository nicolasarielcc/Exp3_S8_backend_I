{
  "info": {
    "name": "LearningPlatformValidation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Listar usuarios",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/usuarios"
      },
      "response": []
    },
    {
      "name": "Buscar usuario por ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}"
      },
      "response": []
    },
    {
      "name": "Registrar usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Juan Perez\",\n  \"correo\": \"juan.perez@example.com\",\n  \"contrasena\": \"secreto123\",\n  \"rol\": \"estudiante\"\n}"
        },
        "url": "{{baseUrl}}/api/usuarios"
      },
      "response": []
    },
    {
      "name": "Actualizar usuario",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Juan Perez\",\n  \"correo\": \"juan.actualizado@example.com\",\n  \"contrasena\": \"secreto123\",\n  \"rol\": \"estudiante\"\n}"
        },
        "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}"
      },
      "response": []
    },
    {
      "name": "Eliminar usuario",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}"
      },
      "response": []
    },
    {
      "name": "Listar cursos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cursos"
      },
      "response": []
    },
    {
      "name": "Listar inscripciones por curso",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/inscripciones/curso/{{cursoId}}"
      },
      "response": []
    },
    {
      "name": "Registrar evaluacion",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cursoId\": 1,\n  \"nombre\": \"Prueba 1\",\n  \"puntajeMaximo\": 100,\n  \"fechaAplicacion\": \"2024-01-15T00:00:00.000+00:00\"\n}"
        },
        "url": "{{baseUrl}}/api/evaluaciones"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "usuarioId",
      "value": "1"
    },
    {
      "key": "cursoId",
      "value": "1"
    }
  ]
}
